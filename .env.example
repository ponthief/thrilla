# In production with Caddy reverse-proxy, leave VITE_LNBITS_URL empty
# so all /api/* and /siLNt/* calls go to the same origin (no CORS).
# In development, set it to your LNbits instance so Vite can proxy.
VITE_LNBITS_URL=https://lnbits.example.net

# Extension mount prefix — matches your LNbits extension ID
VITE_SILNT_PREFIX=/siLNt
# PayJoin (imported BIP-84 watch-only + external Sparrow signing). Default off.
# Set true to show the PayJoin nav/section in this build.
VITE_PAYJOIN_ENABLED=false
