# React Native (Android) build config, consumed by react-native-config.
# Copy to a network-specific file (e.g. .env.mainnet) and build with:
#   ENVFILE=.env.mainnet ./gradlew assembleRelease
# These are read in JS as Config.LNBITS_URL, Config.SILNT_PREFIX, etc.
LNBITS_URL=https://lnbits.example.net
SILNT_PREFIX=/siLNt
NETWORK_LOCK=mainnet
APP_NAME=WhiSPa
PAYJOIN_ENABLED=false
TANGO_ENABLED=false
# Lightning. The same flag as VITE_LIGHTNING_ENABLED, read through
# react-native-config (src/theme.ts).
LIGHTNING_ENABLED=false
