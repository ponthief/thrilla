# Build with: npm run build:mainnet   (or: vite build --mode mainnet)
# Produces the user-facing MAINNET Thrilla build — this is the one packaged
# into the Android APK. BitMail/BIP-353 enabled; QR Scan button enabled
# (mainnet only); native MLKit scanner used inside the app.
#
# IMPORTANT: set VITE_LNBITS_URL to your MAINNET LNbits host. In the packaged
# APK there is no same-origin fallback, so this MUST be a full absolute URL to
# the mainnet backend (e.g. https://thrilla.me). Do NOT leave it blank and do
# NOT point it at signet.

VITE_LNBITS_URL=https://lnbits.thrilla.me
VITE_SILNT_PREFIX=/siLNt
VITE_NETWORK_LOCK=mainnet
VITE_DISABLE_BIP353=false
VITE_APP_NAME=WhiSPa
VITE_PAYJOIN_ENABLED=true
# Tango: the two-party equal-output mix. Its own switch, because it is a
# different feature to a user — a PayJoin pays someone, a Tango pays nobody.
VITE_TANGO_ENABLED=true
# Lightning: the LNbits wallet every account already has — its balance on the
# Wallet screen, a bolt11 invoice on Receive, paying one on Send. A build flag
# rather than a network check, because whether Lightning works is a fact about
# the LNbits instance this build points at. The phone reads the un-prefixed
# LIGHTNING_ENABLED under the same name.
VITE_LIGHTNING_ENABLED=false

# ── React Native (Android) build via react-native-config ─────────────────────
# The mobile app reads these (un-prefixed) keys as `Config.*`. This file is
# selected automatically by the "mainnet" build flavor (see android/app/build.gradle
# envConfigFiles) — no ENVFILE needed. Build the mainnet APK with:
#   npm run android                 (debug, run on a device)
#   npm run apk:mainnet             (release APK → assembleMainnetRelease)
# Unlike the web build there is no same-origin fallback, so LNBITS_URL MUST be a
# full absolute URL to the mainnet backend.
LNBITS_URL=https://lnbits.thrilla.me
SILNT_PREFIX=/siLNt
NETWORK_LOCK=mainnet
# Lightning. The same flag as VITE_LIGHTNING_ENABLED, read through
# react-native-config (src/theme.ts).
LIGHTNING_ENABLED=false
APP_NAME=WhiSPa
PAYJOIN_ENABLED=true
