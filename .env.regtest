# Build with: npm run build:regtest   (i.e. vite build --mode regtest)
# Produces a Regtest-only Thrilla build for LOCAL development/testing against a
# local regtest stack (bitcoind + LND + Boltz docker-regtest). BitMail/BIP-353
# is disabled — it depends on real Cloudflare DNS and a public domain, which
# don't exist on regtest.

# Same-origin API by default (served behind your local reverse proxy / dev).
# If you point the regtest build at a specific LNbits, set the full URL here.
VITE_LNBITS_URL=
VITE_SILNT_PREFIX=/siLNt
VITE_NETWORK_LOCK=regtest
VITE_DISABLE_BIP353=true
VITE_APP_NAME=Thrilla (regtest)
