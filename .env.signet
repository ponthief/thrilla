# ── Web build (Vite) ──────────────────────────────────────────────────────────
# Build with: npm run build -- --mode signet
# Produces a Signet-only Thrilla web build (BitMail/BIP-353 enabled).
VITE_LNBITS_URL=
VITE_SILNT_PREFIX=/siLNt
VITE_NETWORK_LOCK=signet
VITE_DISABLE_BIP353=false
VITE_APP_NAME=Thrilla
VITE_PAYJOIN_ENABLED=true

# ── React Native (Android) build via react-native-config ──────────────────────
# The mobile app reads these (un-prefixed) keys as `Config.*`, injected at build
# time by react-native-config. Build the Signet APK with:
#   ENVFILE=.env.signet npm run android                 (debug, run on device)
#   ENVFILE=.env.signet ./gradlew assembleRelease       (release APK, run from android/)
# Unlike the web build there is NO same-origin fallback, so LNBITS_URL MUST be a
# full absolute URL to your SIGNET LNbits backend.
LNBITS_URL=https://CHANGE-ME-signet-lnbits-host
SILNT_PREFIX=/siLNt
NETWORK_LOCK=signet
APP_NAME=Thrilla Signet
PAYJOIN_ENABLED=true
